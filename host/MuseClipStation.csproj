<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>MuseClipStation</AssemblyName>
    <RootNamespace>MuseClipStation</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>Clipa</AssemblyTitle>
    <FileDescription>Clipa</FileDescription>
    <Description>Clipa - 截图、录屏与剪贴面板</Description>
    <Product>Clipa</Product>
    <Company>青言悦语工作室</Company>
    <Copyright>青言悦语工作室</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <EmbeddedResource Include="app.html" LogicalName="app.html" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>
</Project>
